{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Android APK (Release)",
            "type": "shell",
            "command": "flutter build apk --release",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
           "label": "Clean Android Gradle Cache",
            "type": "shell",
            // We removed the 'cd' from the command. It's cleaner.
            "command": "./gradlew.bat clean",
            "options": {
                // We tell the task to run directly from INSIDE the android folder.
                "cwd": "${workspaceFolder}/maxtrack/android"
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        }
    ]
}