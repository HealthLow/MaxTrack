{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Android APK (Release)",
            "type": "shell",
            "command": "flutter build apk --release",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        }
    ]
}